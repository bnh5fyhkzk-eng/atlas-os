{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://atlas-backend.upliftai.app/api/$1" },
    { "source": "/dashboard-plugins/(.*)", "destination": "https://atlas-backend.upliftai.app/dashboard-plugins/$1" },
    { "source": "/(.*)", "destination": "https://atlas-backend.upliftai.app/$1" }
  ]
}
