{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/", "destination": "/us.html" },
    { "source": "/home", "destination": "/app.html" },
    { "source": "/manager", "destination": "/app.html" },
    { "source": "/arm/:slug", "destination": "/app.html" },
    { "source": "/arm/:slug/:pageId", "destination": "/app.html" },
    { "source": "/api/(.*)", "destination": "https://api.atlasos.me/api/$1" },
    { "source": "/dashboard-plugins/(.*)", "destination": "https://api.atlasos.me/dashboard-plugins/$1" }
  ]
}
