{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/", "destination": "/us.html" },
    { "source": "/((?!api/|assets/|us\\.html|favicon\\.ico|app\\.html).*)", "destination": "/app.html" }
  ]
}
