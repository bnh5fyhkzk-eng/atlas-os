# Atlas-OS · environment variables
# Copy to .env.local (never committed) and fill in real values.

# ── Supabase (existing house data layer — default AtlasBar path) ──────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Bridge mode (opt-in) ────────────────────────────────────────────────
# Wires AtlasBar's bridge-mode toggle to the real Atlas engine
# (atlas-terminal/bridge/server.py) instead of the Supabase /api/chat room.
# Off by default even when set — brother flips the toggle in the bar.

# Base URL of the bridge (server.py), reachable from the browser.
# Falls back to https://engine.atlasos.me if unset.
VITE_ATLAS_ENGINE_URL=https://engine.atlasos.me

# Bridge auth token — sent as the X-Atlas-Token header on every request
# (POST /cmd, GET /events/stream, POST /voice/tts, GET /engine/health).
# Must match ATLAS_BRIDGE_TOKEN on the bridge host. Required for bridge mode
# to appear enabled in the bar at all.
VITE_ATLAS_ENGINE_TOKEN=

# Optional — pins the model sent on spawn_session/send_message
# (one of: claude-opus-4-7, claude-opus-4-8, claude-sonnet-5, claude-haiku-4-5,
# claude-fable-5, local, api, gemma3:4b, gemma4:e4b). Leave unset to let the
# bridge use its own server-side default.
VITE_ATLAS_ENGINE_MODEL=
